      "read": "^(tbp\\.cdc|tigerbeetle\\..*)$"
    },
    {
      "user": "tbp-service",
      "vhost": "/",
      "configure": "^$",
      "write": "^tbp\\.rpc$",
      "read": "^$"
    }
  ],
  "exchanges": [
    {
      "name": "tbp.cdc",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
