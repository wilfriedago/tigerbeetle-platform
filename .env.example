# Copy to .env to override defaults for `just compose-up`. Every variable has a default, so the stack
# starts without a .env file. Never commit .env.

# --- Host ports published by docker compose -----------------------------------------------------
# Postgres and TigerBeetle use uncommon host ports so the stack coexists with a local Postgres
# on 5432 or a dev server on 3000. Inside the compose network they keep their standard ports.
API_PORT=8080
CONSOLE_PORT=5173
POSTGRES_PORT=15432
TIGERBEETLE_PORT=13000
# Keycloak (admin console, login pages) and Mailpit (the emails Keycloak sends).
KEYCLOAK_PORT=18080
MAILPIT_PORT=18025

# --- Postgres container credentials (also used to build POSTGRES_URL for the api container) ------
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# --- API service configuration (read by apps/api, see internal/platform/config) ------------------
# Listen address of the HTTP server.
API_ADDR=:8080
# slog level: debug, info, warn or error.
LOG_LEVEL=info
# Connection string for Postgres (pgx pool). Required when running the binary outside compose.
POSTGRES_URL=postgres://ledger:ledger@localhost:15432/ledger?sslmode=disable
# TigerBeetle cluster ID. 0 is reserved for development and testing.
TIGERBEETLE_CLUSTER_ID=0
# Comma-separated TigerBeetle replica addresses. Required when running the binary outside compose.
TIGERBEETLE_ADDRESSES=localhost:13000
# Run goose migrations before serving. The compose stack sets this to true.
MIGRATE_ON_START=false
# How long to wait for in-flight requests on SIGTERM.
SHUTDOWN_TIMEOUT=10s
# Per-dependency timeout used by GET /readyz and GET /v1/_info.
READINESS_TIMEOUT=2s
# Upper bound of every TigerBeetle request made for an API call. A write that times out stays
# pending and the reconciler settles it.
TIGERBEETLE_TIMEOUT=5s
# A pending write older than this is treated as interrupted and settled by the reconciler.
RECONCILER_GRACE_PERIOD=30s
# How often the reconciler looks for interrupted writes.
RECONCILER_INTERVAL=10s
# Serve the REST operations of the ledgers and bookkeeping modules. /healthz, /readyz and /v1/_info
# are always served.
REST_ENABLED=true
# Serve POST /graphql, the console's API (ADR-0023).
GRAPHQL_ENABLED=true
# Run the reconciler in the API process. Turn it off only where another process settles writes.
RECONCILER_ENABLED=true
# Serve gRPC (ADR-0021) on GRPC_ADDR, with server reflection for grpcurl. Development only until
# authentication is decided.
GRPC_ENABLED=false
GRPC_ADDR=:9090
# Serve the RPC methods (v1.<operationId>) over RabbitMQ and NATS (ADR-0021). Development only until
# authentication is decided; enabling one without its URL is a startup error. A broker that is
# down makes /readyz report "degraded" with a 200.
AMQP_RPC_ENABLED=false
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_RPC_QUEUE=tbp.rpc.v1
NATS_RPC_ENABLED=false
NATS_URL=nats://localhost:4222
NATS_RPC_QUEUE_GROUP=tbp-api
# Requests each broker server runs at once, and the longest any request may run.
RPC_CONCURRENCY=16
RPC_TIMEOUT_MAX=30s
# Relay TigerBeetle change events (CDC, through RabbitMQ) to Kafka (ADR-0022). Development only
# until authentication is decided; enabling it needs KAFKA_BROKERS and CDC_AMQP_URL. A Kafka that is
# down makes /readyz report "degraded" and holds events in RabbitMQ until it is back.
KAFKA_EVENTS_ENABLED=false
KAFKA_BROKERS=localhost:9094
KAFKA_EVENTS_TOPIC=tbp.ledger-events.v1
CDC_AMQP_URL=amqp://guest:guest@localhost:5672/
CDC_QUEUE=tbp.ledger-events.relay

# Authentication is always on (ADR-0025). The issuer is the Keycloak realm as browsers reach it;
# AUTH_DISCOVERY_URL is where the API reads discovery and keys when it reaches Keycloak at another
# address (inside compose: http://keycloak:8080/realms/tbp). Empty means AUTH_ISSUER_URL.
AUTH_ISSUER_URL=http://localhost:18080/realms/tbp
AUTH_DISCOVERY_URL=
AUTH_AUDIENCE=tbp-api
# The claim and value that mark the platform's staff, and the claim listing a person's
# organizations by alias (ADR-0026, ADR-0027).
AUTH_STAFF_CLAIM=roles
AUTH_STAFF_VALUE=tbp-staff
AUTH_ORGANIZATION_CLAIM=organization

# --- Console dev server ---------------------------------------------------------------------------
# Where the Vite dev server proxies /api requests to. Inside compose it is http://api:8080.
API_PROXY_TARGET=http://localhost:8080
