# Copy to .env to override defaults for `pnpm stack:up`. Every variable has a default, so the stack
# starts without a .env file. Never commit .env.

# --- Host ports published by docker compose -----------------------------------------------------
API_PORT=8080
CONSOLE_PORT=5173
POSTGRES_PORT=5432
TIGERBEETLE_PORT=3000

# --- Postgres container credentials (also used to build POSTGRES_URL for the api container) ------
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# --- API service configuration (read by apps/api, see internal/platform/config) ------------------
# Listen address of the HTTP server.
API_ADDR=:8080
# slog level: debug, info, warn or error.
LOG_LEVEL=info
# Connection string for Postgres (pgx pool). Required when running the binary outside compose.
POSTGRES_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
# TigerBeetle cluster ID. 0 is reserved for development and testing.
TIGERBEETLE_CLUSTER_ID=0
# Comma-separated TigerBeetle replica addresses. Required when running the binary outside compose.
TIGERBEETLE_ADDRESSES=localhost:3000
# Run goose migrations before serving. The compose stack sets this to true.
MIGRATE_ON_START=false
# How long to wait for in-flight requests on SIGTERM.
SHUTDOWN_TIMEOUT=10s
# Per-dependency timeout used by GET /readyz and GET /v1/_info.
READINESS_TIMEOUT=2s

# --- Console dev server ---------------------------------------------------------------------------
# Where the Vite dev server proxies /api requests to. Inside compose it is http://api:8080.
API_PROXY_TARGET=http://localhost:8080
