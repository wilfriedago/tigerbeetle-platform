{
  "name": "tigerbeetle-platform",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source platform that makes TigerBeetle easier to work with: a ledger API, a web console and, later, a posting-rule DSL.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "generate": "turbo run generate",
    "test:integration": "turbo test:integration",
    "stack:up": "docker compose --project-directory . -f deploy/compose/compose.yaml up --build --detach --wait",
    "stack:down": "docker compose --project-directory . -f deploy/compose/compose.yaml down",
    "stack:logs": "docker compose --project-directory . -f deploy/compose/compose.yaml logs --follow",
    "stack:reset": "docker compose --project-directory . -f deploy/compose/compose.yaml down --volumes",
    "tools:install": "scripts/install-tools.sh",
    "versions:check": "scripts/check-versions.sh",
    "prepare": "vp config --hooks-dir .githooks"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "turbo": "2.11.10",
    "vite-plus": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0 <13"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
