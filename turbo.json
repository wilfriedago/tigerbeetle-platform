{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", "bin/**"]
    },
    "lint": {
      "dependsOn": ["^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vite.config.ts"]
    },
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^generate"]
    },
    "test": {
      "dependsOn": ["^generate"]
    },
    "test:integration": {
      "dependsOn": ["^generate"],
      "cache": false,
      "passThroughEnv": ["DOCKER_HOST", "DOCKER_CERT_PATH", "DOCKER_TLS_VERIFY", "TESTCONTAINERS_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_ADDR",
        "LOG_LEVEL",
        "POSTGRES_URL",
        "TIGERBEETLE_CLUSTER_ID",
        "TIGERBEETLE_ADDRESSES",
        "MIGRATE_ON_START",
        "SHUTDOWN_TIMEOUT",
        "READINESS_TIMEOUT",
        "TIGERBEETLE_TIMEOUT",
        "RECONCILER_GRACE_PERIOD",
        "RECONCILER_INTERVAL",
        "API_PROXY_TARGET",
        "VITE_*"
      ]
    },
    "api#generate": {
      "dependsOn": ["@tigerbeetle-platform/openapi#generate"],
      "inputs": ["sqlc.yaml", "oapi-codegen.yaml", "go.mod", "go.sum", "migrations/**", "queries/**"],
      "outputs": ["internal/adapters/httpapi/gen/**", "internal/adapters/postgres/gen/**"]
    },
    "api#build": {
      "dependsOn": ["api#generate"],
      "inputs": ["**/*.go", "go.mod", "go.sum", "migrations/**", "queries/**", "sqlc.yaml", "oapi-codegen.yaml"],
      "outputs": ["bin/**"]
    },
    "api#lint": {
      "dependsOn": ["api#generate"],
      "inputs": ["**/*.go", "go.mod", "go.sum", ".golangci.yml", "migrations/**", "queries/**"]
    },
    "api#test": {
      "dependsOn": ["api#generate"],
      "inputs": ["**/*.go", "go.mod", "go.sum", "migrations/**", "queries/**"]
    },
    "api#test:integration": {
      "dependsOn": ["api#generate"],
      "inputs": ["**/*.go", "go.mod", "go.sum", "migrations/**", "queries/**"],
      "cache": false,
      "passThroughEnv": ["DOCKER_HOST", "DOCKER_CERT_PATH", "DOCKER_TLS_VERIFY", "TESTCONTAINERS_*"]
    }
  }
}
