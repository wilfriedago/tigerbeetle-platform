{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vite.config.ts"]
    },
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^generate"]
    },
    "test": {
      "dependsOn": ["^generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_PROXY_TARGET", "VITE_*"]
    },
    "console#generate": {
      "dependsOn": ["^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/graphql/schema.graphql"],
      "outputs": []
    }
  }
}
