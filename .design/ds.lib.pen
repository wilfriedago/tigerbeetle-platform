    {
      "type": "frame",
      "id": "vw9co",
      "x": 3080,
      "y": 5700,
      "name": "22 Pickers and steps",
      "theme": {
        "mode": "light",
        "density": "comfortable"
      },
      "width": 1440,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 48,
      "padding": [
        64,
        72
      ],
      "children": [
        {
          "type": "frame",
          "id": "u5tSrF",
          "name": "Board Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "p7nBsT",
              "name": "Overline",
              "fill": "$text-subtle",
              "content": "ledger components / pickers and steps",
              "fontFamily": "$font-mono",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "V8lTC7",
              "name": "Title",
              "fill": "$text",
              "content": "Pickers and steps",
              "fontFamily": "$font-sans",
              "fontSize": 36,
              "fontWeight": "600",
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "d9iO9H",
              "name": "Description",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 760,
              "content": "The stepper paces long writes such as a new transaction. The account combobox replaces typing addresses by hand: it searches existing accounts by prefix, shows what each can spend, and still allows a new address, saying which rule will create it.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "O0T3hf",
          "name": "Section: Stepper",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "uStVV",
              "name": "Section Header",
              "width": "fill_container",
              "stroke": "$border",
              "strokeWidth": {
                "bottom": 1
              },
              "layout": "vertical",
              "gap": 4,
              "padding": [
